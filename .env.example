# Solo il minimo per avviare: chiavi API, utenti e cartella si configurano dal pannello web.

# Chiave per cifrare i segreti nel database e firmare i cookie di sessione.
# Generala con: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ATTENZIONE: se la cambi, i segreti salvati (Gemini, Composio, token del bot) vanno reinseriti.
SECRET_KEY=

# Utente del pannello e password iniziale (usata solo se nel database non ne esiste ancora una).
ADMIN_USER=admin
ADMIN_PASSWORD=

# Cartella dell'host che il pannello potrà sfogliare per scegliere dove salvare i documenti.
# NAS: /mnt/nas    PC: /Users/tuonome/Documents (macOS) oppure C:/Users/tuonome/Documents (Windows)
STORAGE_ROOT=

WEB_PORT=8080
# Se il pannello è dietro un reverse proxy HTTPS metti 1 (cookie solo su HTTPS).
COOKIE_SECURE=0
